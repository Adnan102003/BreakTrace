# Default local workspace. The API binds to 127.0.0.1.
BREAKTRACE_PORT=4311
BREAKTRACE_DATA=.data

# Optional local Chromium cache. Omit to use Playwright’s default cache.
# PLAYWRIGHT_BROWSERS_PATH=.tools/browsers

# Workspace HTTP authentication. The username is operator.
# Generate the password with node -p "require('node:crypto').randomBytes(32).toString('base64url')"
# Set the requirement flag for private deployments. Leave the Docker bind flag to the image.
# BREAKTRACE_OPERATOR_PASSWORD=
# BREAKTRACE_REQUIRE_OPERATOR_AUTH=1
# BREAKTRACE_CONTAINER=0

# MongoDB mode. The JSON store is used when the URI is unset.
# In a deployment use a database-scoped readWrite user and percent-encode URI credentials.
# BREAKTRACE_MONGO_URI=mongodb://127.0.0.1:27017/breaktrace
# BREAKTRACE_MONGO_DB=breaktrace

# Local Docker Mongo overlay bootstraps its private Mongo database with these credentials.
# BREAKTRACE_MONGO_USER=
# BREAKTRACE_MONGO_PASSWORD=
# For the Compose overlay set BREAKTRACE_MONGO_URI with host mongo and authSource=admin.

# Comma-separated origins that the operator controls. Each target also requires a proof file.
# BREAKTRACE_ALLOWED_ORIGINS=https://staging.example.com
# BREAKTRACE_ALLOWED_LOCAL_ORIGINS=http://127.0.0.1:4313

# Workflow input variables. Use the exact BREAKTRACE_INPUT_* name in the recorded draft.
# BREAKTRACE_INPUT_ROOM_FILTER=

# Optional model integrations. Deterministic analysis requires no service or credential.
# BREAKTRACE_OLLAMA_MODEL=
# BREAKTRACE_OPENAI_MODEL=
# BREAKTRACE_OPENAI_API_KEY=
# BREAKTRACE_GEMINI_MODEL=
# BREAKTRACE_GEMINI_API_KEY=

# Optional GitHub metadata integration. Use an allowlisted repository and a read-only token.
# BREAKTRACE_GITHUB_REPOSITORIES=owner/repository
# BREAKTRACE_GITHUB_TOKEN=

# Optional JSON map of project IDs to trusted static output directories.
# BREAKTRACE_REPAIR_ROOTS={"rooms":"/srv/room-board/dist"}

# Tests and generated specs. Export the applicable variables in the test shell.
# Use a disposable Mongo instance for the test URI.
# BREAKTRACE_TEST_MONGO_URI=mongodb://127.0.0.1:27017
# BREAKTRACE_TARGET_PROOF=
# BREAKTRACE_RESILIENT=1
# BREAKTRACE_GENERATED_DIR=tests/generated
# BREAKTRACE_GENERATED_OUTPUT=test-results/generated
# PLAYWRIGHT_JSON_OUTPUT_FILE=test-results/results.json
