BREAKTRACE_PORT=4311
BREAKTRACE_DATA=.data
# Use this when the matching Playwright browsers are installed under .tools.
# PLAYWRIGHT_BROWSERS_PATH=.tools/browsers
# Enable MongoDB persistence with an operator-managed connection string.
# BREAKTRACE_MONGO_URI=mongodb://127.0.0.1:27017/breaktrace
# BREAKTRACE_MONGO_DB=breaktrace
# Comma-separated HTTPS staging origins you control, on port 443.
# BREAKTRACE_ALLOWED_ORIGINS=https://staging.example.com
# Explicit loopback applications owned by the operator.
# BREAKTRACE_ALLOWED_LOCAL_ORIGINS=http://127.0.0.1:4313
# Optional local Ollama model already installed on 127.0.0.1:11434
# BREAKTRACE_OLLAMA_MODEL=
# Optional hosted providers. Keep API keys in the server environment.
# BREAKTRACE_OPENAI_MODEL=
# BREAKTRACE_OPENAI_API_KEY=
# BREAKTRACE_GEMINI_MODEL=
# BREAKTRACE_GEMINI_API_KEY=
# Optional comma-separated GitHub repository slugs and a read-only metadata token.
# BREAKTRACE_GITHUB_REPOSITORIES=owner/repository
# BREAKTRACE_GITHUB_TOKEN=
# Optional JSON map from project IDs to absolute trusted static output directories.
# BREAKTRACE_REPAIR_ROOTS={"rooms":"C:/work/room-board/dist"}
