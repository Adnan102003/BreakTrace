{
  "name": "breaktrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12 || ^24.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "demo": "tsx apps/demo/main.ts",
    "fixture:rooms": "tsx scripts/room-board.ts",
    "start": "tsx apps/api/main.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:generated": "playwright test --config playwright.generated.config.ts",
    "smoke": "tsx scripts/smoke.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:rooms": "tsx scripts/rooms-benchmark.ts",
    "gate": "tsx scripts/gate.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@xyflow/react": "^12.9.0",
    "dotenv": "^17.2.0",
    "express": "^5.2.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.562.0",
    "mongoose": "^9.13.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.61.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.21.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "prettier": "^3.7.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
